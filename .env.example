# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# LLM provider for enrichment, cluster labeling, rerank, and the daily briefs.
# Default is "openrouter" — one key, every model, free model-switching. It
# routes to Gemini 2.5 Flash-Lite by default for the high-volume per-item work
# (~10x cheaper than Claude Haiku; enrichment is ~80-90% of LLM spend).
# Supported: openrouter | gemini | openai | deepseek | anthropic.
# -----------------------------------------------------------------------------
LLM_PROVIDER=openrouter
# Key for the active provider. Set the provider-specific key, or set LLM_API_KEY
# once (it wins for whichever provider is selected).
OPENROUTER_API_KEY=
# GEMINI_API_KEY=        # if LLM_PROVIDER=gemini (direct, no OpenRouter fee)
# LLM_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional model overrides (defaults are tuned per provider in lib/llm/chat.ts).
# ENRICH_MODEL / LABEL_MODEL = cheap high-volume tier; RERANK_MODEL / BRIEF_MODEL
# = stronger low-volume tier. For OpenRouter use provider-prefixed slugs, e.g.
# ENRICH_MODEL=google/gemini-2.5-flash-lite
# ENRICH_MODEL=
# LABEL_MODEL=
# RERANK_MODEL=
# BRIEF_MODEL=

# Anthropic — only required when LLM_PROVIDER=anthropic (the fallback path).
ANTHROPIC_API_KEY=

# Voyage AI (for embeddings - optional, enables semantic dedup)
# 200M free tokens on signup (~6 months at this app's volume); then $0.06/M.
VOYAGE_API_KEY=

# Secret for cron endpoint auth (any long random string)
CRON_SECRET=

# Days of news to retain. Items older than this are auto-pruned at ingest time.
# Default: 14. Raise for more history (and more enrichment spend on backfill).
ITEM_RETENTION_DAYS=14

# Public site URL (used for OG tags, push notifications)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: GitHub token (raises trending/search rate limits 60/hr -> 5000/hr)
GITHUB_TOKEN=

# Optional: Semantic Scholar API key (higher rate limits for arXiv citation enrichment)
SEMANTIC_SCHOLAR_API_KEY=

# -----------------------------------------------------------------------------
# Redis — region-keyed listing cache (sits between server and Supabase).
# If REDIS_URL is unset, the app still works but every read hits Postgres.
# When using docker-compose, the compose file overrides this to redis://redis:6379.
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# S3 — thumbnail storage ONLY. Works with AWS S3, Cloudflare R2, MinIO, etc.
# If S3_BUCKET is unset, thumbnail upload becomes a no-op and items have no
# stored thumbnail (the app degrades gracefully).
# -----------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
# Leave S3_ENDPOINT empty for real AWS. For R2/MinIO set the endpoint:
#   R2:    https://<account>.r2.cloudflarestorage.com
#   MinIO: http://minio:9000
S3_ENDPOINT=
# Required for non-AWS S3 in most cases.
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL used to render thumbnails. Defaults to AWS-style path
# when unset; set this when fronting the bucket with a custom domain or CDN.
S3_PUBLIC_BASE_URL=
